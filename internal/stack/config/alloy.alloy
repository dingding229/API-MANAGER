local.file_match "api_manager" {
  path_targets = [{__path__ = "__DATA_DIR__/logs.jsonl", job = "api-manager"}]
  sync_period = "5s"
}
loki.source.file "api_manager" {
  targets = local.file_match.api_manager.targets
  forward_to = [loki.write.local.receiver]
}
loki.write "local" {
  endpoint {
    url = "http://127.0.0.1:3100/loki/api/v1/push"
  }
}
