API_MANAGER_IMAGE=dingding229/api-manager:latest
HTTP_ADDR=:8080
PRODUCTION_MODE=false
# Production: use the separate compose.production.yaml and mounted *_FILE secrets.
# METRICS_TOKEN=generate-a-separate-random-32-byte-secret
ADMIN_TOKEN=generate-with-openssl-rand-hex-32
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
MAX_BODY_BYTES=1048576
POSTGRES_PASSWORD=generate-an-independent-db-password
POSTGRES_DSN=postgres://api_manager:<POSTGRES_PASSWORD>@postgres:5432/api_manager?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_TLS_ENABLED=false
# REDIS_USERNAME=
USER_JWT_SECRET=generate-an-independent-random-32-byte-secret
USER_JWT_TTL=12h
USE_REDIS=false
PLUGIN_DIR=data/plugins
PLUGIN_MAX_BYTES=20971520
PLUGIN_DATABASE_WRITES_ENABLED=false
# 仅为将来 host ABI 预留；当前即使设为 true，WASM 插件也无法执行数据库写入。
PLUGIN_LIBRARY_DIR=plugin-library
# 独立、稳定的加密密钥；丢失/更换后旧密钥无法恢复。
CREDENTIAL_ENCRYPTION_KEY=generate-an-independent-random-32-byte-secret
CORS_ORIGINS=https://admin.example.com

# Built-in logs, metrics, traces, alerts and dashboard
OBSERVABILITY_DIR=data/observability
OBSERVABILITY_MAX_LOGS=5000
OBSERVABILITY_MAX_TRACES=2000
OBSERVABILITY_FILE_MAX_BYTES=16777216

# Full upstream stack, included in the image but off by default.
# Enable with a distinct 32+ character password, a persistent volume, and >= 2 GiB memory.
OBSERVABILITY_STACK_ENABLED=false
# GRAFANA_ADMIN_PASSWORD=generate-a-separate-32-character-secret

# Optional additional OpenTelemetry export to an external collector
OTEL_ENABLED=false
OTEL_SERVICE_NAME=api-manager
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector.internal:4317
OTEL_EXPORTER_OTLP_INSECURE=false

# Per-API proxy reliability policy is configured in the API resource:
# upstream_timeout_ms, upstream_retries, circuit_breaker_threshold,
# circuit_breaker_reset_seconds.

# Server-owned upstream credentials. API definitions store only upstream_auth_ref.
# Origin must match exactly (scheme, hostname, port); never put real keys in route JSON.
# API_UPSTREAM_CREDENTIALS={"catalog-service":{"origin":"https://catalog.internal","api_key":"replace-with-upstream-service-key"}}
