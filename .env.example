# Optional overrides. Credentials are generated into secrets/, not stored here.
API_MANAGER_IMAGE=docker.io/dingding229/api-manager:latest
SECRETS_DIR=./secrets
API_BIND_ADDR=127.0.0.1
API_PORT=8080
OBSERVABILITY_STACK_ENABLED=false
API_MEMORY_LIMIT=2g
API_CPUS=2.0


# Business API origin only, e.g. https://api.example.com
PUBLIC_API_BASE_URL=

ADMIN_PATH=/admin

# Optional password recovery. Leave SMTP_HOST empty to disable email recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_MODE=starttls
SMTP_FROM=
SMTP_USERNAME=
# Password is mounted from secrets/smtp_password; never commit SMTP credentials.
PASSWORD_RESET_BASE_URL=

# Optional private-repository version check. Token is read from
# secrets/github_update_token (single-repository, Contents: read-only).
# Leave the file empty to disable authenticated GitHub checks.

# Only trusted ingress IP ranges may supply client IPs via X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
